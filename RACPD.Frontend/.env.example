# URL pública del proyecto Supabase
VITE_SUPABASE_PROJECT_URL=

# Clave anónima pública del proyecto Supabase (anon key, NO service_role)
VITE_SUPABASE_ANON_KEY=

# URL base del frontend. Se usa para construir el `redirectTo` que
# Supabase Auth incluye en los correos (recuperación de contraseña,
# invitaciones, etc.). En desarrollo es http://localhost:5174 (puerto
# fijado en vite.config.ts → server.port). Si no se define, el frontend
# hace fallback a window.location.origin.
VITE_APP_URL=http://localhost:5174

# URL base del backend de RACPD (FastEndpoints)
VITE_API_URL=http://localhost:5000
