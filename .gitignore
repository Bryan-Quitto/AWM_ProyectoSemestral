.DS_Store
Thumbs.db
desktop.ini
*.lnk
*.temp
*.bak

# --- [ Editores e IDEs ] ---
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
