*.njsproj
*.ntvs*
*.swp
*.swo
*.sw?
.vs/

# --- [ Node.js / Frontend (RACPD.Frontend) ] ---
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
coverage/
.next/
out/
build/
.vercel
.netlify

# --- [ .NET / Backend (RACPD.Backend) ] ---
[Bb]in/
[Oo]bj/
[Rr]elease/
[Dd]ebug/
*.exe
*.dll
*.pdb
*.DotSettings.user
