# --- [ Frontend Lockfiles ] ---
# Git rastrea estos archivos, pero son miles de lineas de hashes de versiones
# que la IA no necesita para programar.
package-lock.json
pnpm-lock.yaml
yarn.lock

# --- [ Migraciones de Base de Datos ] ---
# El historial de codigo C# autogenerado por Entity Framework Core es masivo.
# Antigravity solo necesita leer las Entidades/Modelos y el DbContext, no las migraciones.
**/Migrations/

# --- [ Archivos Estaticos y Multimedia ] ---
# Git rastrea los assets, pero para el LLM son ruido en el contexto.
*.svg
*.png
*.jpg
*.jpeg
*.ico
*.gif
*.webp
*.avif

# --- [ Datos Estaticos y Documentacion Pesada ] ---
*.pdf
*.docx
*.csv

# --- [ Dependencias de Terceros ] ---
# No necesito leer el codigo de otras personas, asumo que las librerias funcionan.
node_modules/
packages/

# --- [ Compilados y Binarios (.NET y Frontend) ] ---
# Archivos autogenerados al compilar, minificados o mapas de codigo.
bin/
obj/
dist/
build/
out/
*.min.js
*.min.css
*.map

# --- [ Logs y Reportes de Pruebas ] ---
*.log
logs/
TestResults/
coverage/

# --- [ Carpetas de Entornos Virtuales e IDEs ] ---
.vs/
.idea/
.next/

# --- [ Bases de Datos Locales ] ---
*.db
*.sqlite
*.sqlite3
*.mdf
*.ldf

# --- [ RACPD - Autogenerados Orval (API) ] ---
